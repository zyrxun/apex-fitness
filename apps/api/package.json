{
  "name": "@apex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/dev.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@apex/shared": "*",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.1.0",
    "openapi-types": "^12.1.3",
    "otplib": "^13.4.1",
    "postgres": "^3.4.9",
    "uuid": "^14.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
